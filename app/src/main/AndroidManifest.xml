<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rearscreenfix">

    <!-- LSPosed modul metadata -->
    <application
        android:label="RearScreenFix"
        android:description="@string/xposed_description"
        android:icon="@android:drawable/ic_menu_manage"
        android:allowBackup="false"
        android:hasCode="true">

        <!-- Označava da je ovo Xposed modul -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <!-- Opis modula (prikazuje se u LSPosed manageru) -->
        <meta-data
            android:name="xposeddescription"
            android:value="Popravak primjene teme na rear screenu za Xiaomi popsicle (EliteGaming HyperOS 3.0). Rješava problem s rights datotekom koja blokira ThemeManager." />

        <!-- Minimalna verzija Xposed API-ja -->
        <meta-data
            android:name="xposedminversion"
            android:value="53" />

        <!-- Opseg hookova — ThemeManager (i SubScreenCenter se hookuje runtime) -->
        <meta-data
            android:name="xposedscope"
            android:value="com.android.thememanager" />

    </application>

</manifest>
